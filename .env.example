# Copia in `.env` (o imposta le variabili nell'ambiente) prima di avviare in produzione.

# Porta e indirizzo di ascolto
PORT=8765
HOST=0.0.0.0

# Cartella del database SQLite (viene creata se manca). In Docker è un volume.
DATA_DIR=./data

# Metti a 1 quando l'app è servita in HTTPS (direttamente o dietro un reverse proxy):
# il cookie di sessione viene marcato "Secure".
COOKIE_SECURE=0

# Metti a 1 se l'app sta dietro un reverse proxy (nginx, Caddy, Traefik) che imposta
# X-Forwarded-For / X-Forwarded-Proto: serve per il limite tentativi di login per IP.
TRUST_PROXY=0

# Durata della sessione in giorni
SESSION_DAYS=30

# --- Configurazione automatica al primo avvio (facoltativa) ---
# Se il database è vuoto e queste due variabili sono impostate, l'amministratore viene creato
# senza passare dalla schermata di configurazione. Utile per demo su hosting senza disco persistente.
# SETUP_ADMIN_EMAIL=admin@example.it
# SETUP_ADMIN_PASSWORD=cambiami-subito
# SETUP_ADMIN_NAME=Amministrazione
# SEED_DEMO=1 carica lo scenario dimostrativo; DEMO_SEGNALATORE_PASSWORD crea l'accesso del broker demo (Giorgio Parodi).
# SEED_DEMO=1
# DEMO_SEGNALATORE_PASSWORD=cambiami-anche-questa
